{
  "name": "@jujijigo/brave-search-mcp",
  "version": "1.0.0",
  "description": "Brave Search API 的 MCP 服务器，把网页搜索端点暴露成 web_search 工具",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kywrl/brave-mcp.git"
  },
  "homepage": "https://github.com/kywrl/brave-mcp#readme",
  "bugs": {
    "url": "https://github.com/kywrl/brave-mcp/issues"
  },
  "bin": {
    "brave-search-mcp": "bin/brave-search-mcp.js"
  },
  "main": "./src/server.js",
  "exports": {
    ".": "./src/server.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/brave-search-mcp.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "brave",
    "brave-search",
    "search",
    "claude"
  ]
}
